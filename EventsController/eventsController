package EventsController;

import app.AppState;
import model.Event;
import ui.Dialogs;
import javafx.beans.property.ReadOnlyObjectWrapper;
import javafx.fxml.FXML;
import javafx.scene.control.*;

public final class EventsController {
    @FXML private TableView<Event> table;
    @FXML private TableColumn<Event, java.time.LocalDate> colDate;
    @FXML private TableColumn<Event, String> colTitle;
    @FXML private TableColumn<Event, String> colPortfolio;
    private AppState state;

    public void init(AppState state) {
        this.state = state;
        colDate.setCellValueFactory(v -> new ReadOnlyObjectWrapper<>(v.getValue().getDate()));
        colTitle.setCellValueFactory(v -> new ReadOnlyObjectWrapper<>(v.getValue().getTitre()));
        colPortfolio.setCellValueFactory(v -> new ReadOnlyObjectWrapper<>(
                v.getValue().getPortfolioNom() == null ? "Global" : v.getValue().getPortfolioNom()
        ));
        refresh();
    }

    private void refresh() {
        table.setItems(javafx.collections.FXCollections.observableArrayList(state.getManager().getEvents()));
    }

    @FXML private void onAdd() {
        Event ev = Dialogs.eventDialog(state.portfolios());
        if (ev == null) return;
        state.getManager().getEvents().add(ev);
        refresh();
        state.dataChanged();
    }

    @FXML private void onDelete() {
        Event ev = table.getSelectionModel().getSelectedItem();
        if (ev == null) return;
        if (!Dialogs.confirm("Supprimer", "Supprimer l'event ?")) return;
        state.getManager().getEvents().remove(ev);
        refresh();
        state.dataChanged();
    }
}
